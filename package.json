{
  "name": "dsh-rea",
  "version": "0.2.0",
  "description": "DSH plugin for REA (Reverse Engineer Anything) — Native Binary, Android APK, and Web/Electron static reverse engineering tools for AI agents.",
  "type": "module",
  "main": "./index.mjs",
  "exports": {
    ".": "./index.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "index.mjs",
    "lib/",
    "README.md",
    "LICENSE"
  ],
  "keywords": [
    "dsh",
    "cordis",
    "deepseek-harness",
    "rea",
    "reverse-engineering",
    "android",
    "decompiler",
    "mcp"
  ],
  "dsh": {
    "compat": {
      "minDshVersion": "0.2.0-rc.1",
      "testedDshVersion": "0.2.0-rc.2"
    }
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node test/test.mjs",
    "check": "node --check index.mjs && node --check lib/rea-bridge.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/caixuf/dsh-rea.git"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "Apache-2.0"
}
